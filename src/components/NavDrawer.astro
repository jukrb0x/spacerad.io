---
import { NAV_LINKS, SITE_TITLE_ALT } from "../consts";
import { navChinese } from "../i18n/language";
import CollectionsNav from "./CollectionsNav.astro";
// NavDrawer.astro - Mobile navigation drawer using <dialog> for proper iOS Safari viewport handling
import LanguageToggle from "./LanguageToggle.astro";

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const subpath = pathname.match(/[^/]+/g);
const isActive = (href: string) => href === pathname || href === `/${subpath?.[0] || ""}`;
---

<dialog
    data-nav-overlay
    aria-label="Navigation menu" data-i18n-attr="aria-label" data-i18n-en="Navigation menu" data-i18n-zh="导航菜单"
    data-pagefind-ignore
    class="nav-drawer md:hidden"
    transition:animate="none"
>
    <button
        type="button"
        class="nav-drawer__backdrop"
        data-nav-close
        aria-label="Close navigation menu" data-i18n-attr="aria-label" data-i18n-en="Close navigation menu" data-i18n-zh="关闭导航菜单"></button>
    <div
        data-nav-drawer
        aria-label="Navigation menu" data-i18n-attr="aria-label" data-i18n-en="Navigation menu" data-i18n-zh="导航菜单"
        data-scroll-container
        class="nav-drawer__panel"
    >
        <div class="nav-drawer__toolbar">
            <span class="nav-drawer__label" data-i18n-en="Menu" data-i18n-zh="菜单">Menu</span>
            <div class="nav-drawer__actions">
                <LanguageToggle />
                <button type="button" class="nav-drawer__close focus-accent" data-nav-close
                    aria-label="Close navigation menu" data-i18n-attr="aria-label" data-i18n-en="Close navigation menu" data-i18n-zh="关闭导航菜单">
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
            </div>
        </div>
        <nav class="flex flex-col gap-1 text-base" data-no-preview>
            {
                NAV_LINKS.map((link) => (
                    <> <a
                        href={link.href} data-i18n-en={link.label} data-i18n-zh={navChinese[link.href] || link.label}
                        class:list={[
                            "no-underline inline-flex items-center rounded-md px-3 py-2 transition-interactive focus-accent",
                            isActive(link.href)
                                ? "text-muted cursor-default"
                                : "text-secondary hover:text-accent hover:bg-accent-tint-8",
                        ]}
                        data-nav-link
                        aria-current={isActive(link.href) ? "page" : undefined}
                    >
                        {link.label}
                    </a>{link.href === "/channel" && <CollectionsNav mobile />} </>
                ))
            }
        </nav>
        <button
            type="button"
            class="nav-drawer__phrase"
            data-nav-phrase
            data-nav-phrases={JSON.stringify(SITE_TITLE_ALT)}
            aria-describedby="nav-phrase-hint"
        ><span data-nav-phrase-text></span></button>
        <span id="nav-phrase-hint" class="sr-only"><span data-i18n-en="Show another phrase" data-i18n-zh="换一句话">Show another phrase</span></span>
        <span class="sr-only" data-nav-phrase-status aria-live="polite" aria-atomic="true"></span>
    </div>
</dialog>

<style>
    .nav-drawer__toolbar, .nav-drawer__actions { display: flex; align-items: center; }
    .nav-drawer__toolbar {
        justify-content: space-between;
        min-height: 44px;
    }
    .nav-drawer__actions { gap: 4px; }
    .nav-drawer__label { font-size: 14px; font-weight: 500; line-height: 1.5; color: var(--color-text-secondary); }
    .nav-drawer__close { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 0; background: transparent; color: var(--color-text-primary); cursor: pointer; border-radius: 50%; }
    .nav-drawer__close:hover { color: var(--color-link); background: color-mix(in srgb, var(--color-link) 6%, transparent); }

    .nav-drawer__panel {
        padding: max(24px, env(safe-area-inset-top)) max(1.5rem, env(safe-area-inset-right)) max(1.5rem, env(safe-area-inset-bottom)) max(1.5rem, env(safe-area-inset-left));
    }

    .nav-drawer__panel > * {
        flex-shrink: 0;
    }

    .nav-drawer__phrase {
        margin: auto 0 0;
        align-self: flex-start;
        display: inline-flex;
        align-items: flex-end;
        min-width: 44px;
        min-height: 44px;
        padding: 0;
        border: 0;
        appearance: none;
        background: transparent;
        font: inherit;
        text-align: start;
        cursor: pointer;
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
        line-height: 1.6;
        letter-spacing: 0.04em;
    }

    .nav-drawer[data-nav-input="pointer"] [data-nav-link]:focus-visible {
        outline: none;
    }
</style>

<script>
    import { uiLanguage } from "../i18n/client";
    import { lockScrollForDialog, unlockScrollForDialog } from "../utils/scrollLock";

    // AbortController for document-level listeners so we can clean up on re-init
    let drawerAbort: AbortController | null = null;
    let lastPhrase = "";

    function initNavDrawer() {
        const toggleButton = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
        const overlay = document.querySelector<HTMLDialogElement>("[data-nav-overlay]");
        const drawer = document.querySelector<HTMLElement>("[data-nav-drawer]");
        const closeButtons = document.querySelectorAll<HTMLButtonElement>("[data-nav-close]");
        const navLinks = overlay?.querySelectorAll<HTMLAnchorElement>("[data-nav-link]") ?? [];
        const phrase = document.querySelector<HTMLButtonElement>("[data-nav-phrase]");
        const phraseText = document.querySelector<HTMLElement>("[data-nav-phrase-text]");
        const phraseStatus = document.querySelector<HTMLElement>("[data-nav-phrase-status]");
        const phrases = JSON.parse(phrase?.dataset.navPhrases || "[]") as string[];
        let lastFocusedElement: Element | null = null;
        let locked = false;
        let openingFrame = 0;
        let closingTimer: ReturnType<typeof setTimeout> | undefined;

        if (!overlay || !drawer) return;

        // Clean up previous document-level listeners
        drawerAbort?.abort();
        drawerAbort = new AbortController();
        const controller = drawerAbort;
        const { signal } = controller;
        const disposeLanguage = uiLanguage.listen((language) => {
            const open = toggleButton?.getAttribute("aria-expanded") === "true";
            toggleButton?.setAttribute("aria-label", language === "zh" ? (open ? "关闭导航菜单" : "打开导航菜单") : (open ? "Close navigation menu" : "Open navigation menu"));
        });
        signal.addEventListener("abort", disposeLanguage, { once: true });

        const advancePhrase = () => {
            if (!phraseText || phrases.length === 0) return;
            const choices = phrases.filter((value) => value !== lastPhrase);
            lastPhrase = choices[Math.floor(Math.random() * choices.length)] ?? phrases[0];
            phraseText.textContent = lastPhrase;
        };

        const setNavOpen = (open: boolean, focusOrigin = document.activeElement) => {
            if (!overlay || !drawer) return;

            cancelAnimationFrame(openingFrame);
            clearTimeout(closingTimer);

            const wasOpen = toggleButton?.getAttribute("aria-expanded") === "true";
            toggleButton?.setAttribute("aria-expanded", String(open));
            toggleButton?.setAttribute("aria-label", uiLanguage.get() === "zh" ? (open ? "关闭导航菜单" : "打开导航菜单") : (open ? "Close navigation menu" : "Open navigation menu"));

            if (open) {
                if (!wasOpen) advancePhrase();
                if (!overlay.open) {
                    lastFocusedElement = focusOrigin;
                    overlay.showModal();
                }
                if (!locked) { locked = true; lockScrollForDialog(); }
                // Resolve the offscreen state before starting the transition. A single
                // rAF after display:none does not itself guarantee that style was resolved.
                drawer.getBoundingClientRect();
                openingFrame = requestAnimationFrame(() => {
                    overlay.classList.add("is-open");
                    navLinks[0]?.focus({ preventScroll: true });
                });
            } else {
                if (phraseStatus) phraseStatus.textContent = "";
                overlay.classList.remove("is-open");
                if (locked) { locked = false; unlockScrollForDialog(); }
                // Close dialog after CSS transition completes
                closingTimer = setTimeout(() => {
                    if (!overlay.classList.contains("is-open")) {
                        overlay.close();
                        if (lastFocusedElement && "focus" in lastFocusedElement) {
                            (lastFocusedElement as HTMLElement).focus({ preventScroll: true });
                        }
                    }
                }, 200);
            }
        };

        // Bind all controls to this DOM instance, including repeated page-load init.
        phrase?.addEventListener("click", () => {
            // The dialog stays open during its closing animation.
            if (!overlay.open || toggleButton?.getAttribute("aria-expanded") !== "true") return;
            advancePhrase();
            if (phraseStatus) phraseStatus.textContent = lastPhrase;
        }, { signal });

        // Element-level listeners are removed before the DOM swaps.
        toggleButton?.addEventListener("click", (event) => {
            overlay.setAttribute("data-nav-input", event.detail > 0 ? "pointer" : "keyboard");
            setNavOpen(toggleButton.getAttribute("aria-expanded") !== "true", event.detail > 0 ? toggleButton : document.activeElement);
        }, { signal });
        closeButtons.forEach((btn) => btn.addEventListener("click", () => setNavOpen(false), { signal }));
        navLinks.forEach((link) => link.addEventListener("click", () => setNavOpen(false), { signal }));

        // Intercept browser Escape to run animated close instead
        overlay.addEventListener("cancel", (e) => {
            e.preventDefault();
            setNavOpen(false);
        }, { signal });

        overlay.addEventListener("keydown", () => {
            if (overlay.open) overlay.setAttribute("data-nav-input", "keyboard");
        }, { signal });

        // Abort owns all disposal, both before a swap and on same-DOM re-init.
        document.addEventListener("astro:before-swap", () => controller.abort(), { signal });

        const mdQuery = window.matchMedia("(min-width: 768px)");
        const handleMdChange = (e: MediaQueryListEvent) => e.matches && setNavOpen(false);
        mdQuery.addEventListener("change", handleMdChange);
        // Release only this instance's resources before replacing its listeners.
        signal.addEventListener("abort", () => {
            cancelAnimationFrame(openingFrame);
            clearTimeout(closingTimer);
            overlay.classList.remove("is-open");
            toggleButton?.setAttribute("aria-expanded", "false");
            toggleButton?.setAttribute("aria-label", uiLanguage.get() === "zh" ? "打开导航菜单" : "Open navigation menu");
            if (locked) { locked = false; unlockScrollForDialog(); }
            if (overlay.open) overlay.close();
            if (phraseStatus) phraseStatus.textContent = "";
            mdQuery.removeEventListener("change", handleMdChange);
        });
    }

    // astro:page-load fires on initial load AND after each SPA navigation,
    // so a direct call here would cause double-init (duplicate listeners) on first load.
    document.addEventListener("astro:page-load", initNavDrawer);
</script>
