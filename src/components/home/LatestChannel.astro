---
import { Icon } from "astro-icon/components";
import type { TelegramPost } from "../../utils/telegram";

interface Props {
    posts: TelegramPost[];
}
const { posts } = Astro.props;
---
{posts.length ? <div class="channel-index">
  {posts.map(post => <article class="channel-entry">
    <div class="editorial-meta"><time datetime={post.datetime}>{post.datetime.slice(0, 10).replaceAll("-", ".")}</time></div>
    <p><a href={`/channel#${post.id}`} data-channel-preview={post.previewImage ? post.id : undefined} data-channel-image={post.previewImage} data-channel-excerpt={post.previewImage ? (post.text || post.title).slice(0, 180) : undefined}>
      {post.previewImage && <img class="channel-entry__thumbnail" data-channel-thumbnail={post.previewImage} alt="Photo attached to this note" data-i18n-attr="alt" data-i18n-en="Photo attached to this note" data-i18n-zh="这条动态的配图" width="64" height="48" loading="lazy" decoding="async" />}{(post.text || post.title).slice(0, 180)}{(post.text || post.title).length > 180 ? "…" : ""}</a></p>
    {post.hashtags?.[0] && <span class="editorial-kicker">#{post.hashtags[0]}</span>}
  </article>)}
</div> : <p class="channel-fallback"><span data-i18n-en="The channel is temporarily unavailable." data-i18n-zh="电台暂时无法访问。">The channel is temporarily unavailable.</span> <a href="https://t.me/SpaceRad_io" target="_blank" rel="noreferrer"><span data-i18n-en="Read on Telegram" data-i18n-zh="在 Telegram 阅读">Read on Telegram</span> <Icon name="ri:arrow-right-up-line" class="link-arrow" aria-hidden="true" focusable="false" is:inline /></a></p>}
