---
import { Icon } from "astro-icon/components";
import { fetchTelegramChannel, type TelegramPost } from "../../utils/telegram";

// An SSR fragment: Telegram never blocks the static homepage HTML.
let posts: TelegramPost[] = [];
try {
    const channel = await fetchTelegramChannel("SpaceRad_io");
    posts = channel.posts.slice(0, 3);
} catch {
    // A useful direct link remains available if the upstream service is offline.
}
Astro.response.headers.set("Cache-Control", "public, max-age=300, stale-while-revalidate=30");
---
{posts.length ? <div class="channel-index">
  {posts.map(post => <article class="channel-entry">
    <div class="editorial-meta"><time datetime={post.datetime}>{post.datetime.slice(0, 10).replaceAll("-", ".")}</time></div>
    <p><a href={`/channel#${post.id}`}>{(post.text || post.title).slice(0, 180)}{(post.text || post.title).length > 180 ? "…" : ""}</a></p>
    {post.hashtags?.[0] && <span class="editorial-kicker">#{post.hashtags[0]}</span>}
  </article>)}
</div> : <p class="channel-fallback">The channel is temporarily unavailable. <a href="https://t.me/SpaceRad_io" target="_blank" rel="noreferrer">Read on Telegram <Icon name="ri:arrow-right-up-line" class="link-arrow" aria-hidden="true" focusable="false" is:inline /></a></p>}
