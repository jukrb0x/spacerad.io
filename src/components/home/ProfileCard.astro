---
const chineseWords: Record<string, string> = { "Unreal Engine.": "虚幻引擎。", "tools.": "工具。", "teams.": "团队。", "games.": "游戏。", "stories.": "故事。", "performance.": "性能。" };
const words = ["Unreal Engine", "tools", "teams", "games", "stories", "performance"].map((word) => `${word}.`);
---
<div class="home-profile">
    <a href="/me" class="home-profile__about" aria-label="About Jabriel" data-i18n-attr="aria-label" data-i18n-en="About Jabriel" data-i18n-zh="关于 Jabriel">
        <span class="home-profile__greeting" aria-hidden="true">👋</span>
        <h1 id="home-title" aria-label="I build Unreal Engine, tools, teams, games, stories and performance." data-i18n-attr="aria-label" data-i18n-en="I build Unreal Engine, tools, teams, games, stories and performance." data-i18n-zh="我创造虚幻引擎、工具、团队、游戏、故事和性能。"><span class="home-profile__lead" data-i18n-en="I build " data-i18n-zh="我创造 ">I build </span><span class="home-profile__carousel" data-build-words aria-hidden="true">{words.map((word, index) => <span class="home-profile__word" data-i18n-en={word} data-i18n-zh={chineseWords[word]} data-current={index === 0 ? "" : undefined}>{word}</span>)}</span></h1>
        <span class="home-profile__name">Jabriel</span>
    </a>
</div>
<script is:inline data-astro-rerun>
    // Select before first paint; the server-rendered phrase remains the no-JS fallback.
    {
        const chineseWords: Record<string, string> = { "Unreal Engine.": "虚幻引擎。", "tools.": "工具。", "teams.": "团队。", "games.": "游戏。", "stories.": "故事。", "performance.": "性能。" };
const words = document.currentScript.previousElementSibling.querySelectorAll(".home-profile__word");
        if (words.length > 0) {
            words.forEach((word) => word.removeAttribute("data-current"));
            words[Math.floor(Math.random() * words.length)].setAttribute("data-current", "");
        }
    }
</script>
<script>
    let disposeCarousel: (() => void) | undefined;

    function initCarousel() {
        disposeCarousel?.();
        disposeCarousel = undefined;
        const element = document.querySelector<HTMLElement>("[data-build-words]");
        if (!element || !element.animate) return;
        const chineseWords: Record<string, string> = { "Unreal Engine.": "虚幻引擎。", "tools.": "工具。", "teams.": "团队。", "games.": "游戏。", "stories.": "故事。", "performance.": "性能。" };
const words = Array.from(element.querySelectorAll<HTMLElement>(".home-profile__word"));
        if (words.length < 2) return;
        const controller = new AbortController();
        const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
        let index = Math.max(0, words.findIndex((word) => word.hasAttribute("data-current")));
        const indices = words.map((_, i) => i);
        let round = [index, ...shuffle(indices.filter((i) => i !== index))];
        let position = 0;
        let timer: ReturnType<typeof setTimeout> | undefined;
        let animations: Animation[] = [];
        const eligible = () => !controller.signal.aborted && !document.hidden && !motion.matches;

        function shuffle(values: number[], previous?: number) {
            const order = [...values];
            for (let i = order.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [order[i], order[j]] = [order[j], order[i]];
            }
            if (order.length > 1 && order[0] === previous) {
                const j = 1 + Math.floor(Math.random() * (order.length - 1));
                [order[0], order[j]] = [order[j], order[0]];
            }
            return order;
        }

        function pause() {
            clearTimeout(timer);
            animations.forEach((animation) => animation.cancel());
            animations = [];
            words.forEach((word) => word.removeAttribute("data-incoming"));
        }

        function schedule() {
            if (eligible()) timer = setTimeout(exchange, 4000);
        }

        async function exchange() {
            if (!eligible()) return;
            if (position === round.length - 1) {
                round = shuffle(indices, index);
                position = -1;
            }
            const next = round[position + 1];
            words[next].setAttribute("data-incoming", "");
            const outgoing = words[index].animate(
                [{ transform: "translateY(0)" }, { transform: "translateY(-110%)" }],
                { duration: 240, easing: "cubic-bezier(.3, 0, .2, 1)", fill: "both" },
            );
            const incoming = words[next].animate(
                [{ transform: "translateY(110%)" }, { transform: "translateY(0)" }],
                { delay: 40, duration: 260, easing: "cubic-bezier(.22, 1, .36, 1)", fill: "both" },
            );
            animations = [outgoing, incoming];
            try {
                await Promise.all(animations.map((animation) => animation.finished));
            } catch {
                // Cancellation leaves the last settled phrase in place.
                return;
            }
            if (!eligible()) return;
            words[index].removeAttribute("data-current");
            words[next].removeAttribute("data-incoming");
            words[next].setAttribute("data-current", "");
            index = next;
            position++;
            animations.forEach((animation) => animation.cancel());
            animations = [];
            schedule();
        }

        const restart = () => { pause(); schedule(); };
        document.addEventListener("visibilitychange", restart, { signal: controller.signal });
        motion.addEventListener("change", restart, { signal: controller.signal });
        disposeCarousel = () => { pause(); controller.abort(); };
        schedule();
    }
    document.addEventListener("astro:page-load", initCarousel);
    document.addEventListener("astro:before-swap", () => {
        disposeCarousel?.();
        disposeCarousel = undefined;
    });
</script>
