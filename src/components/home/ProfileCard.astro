---
const words = ["Unreal Engine", "tools", "teams", "games", "stories", "performance"].map((word) => `${word}.`);
---
<div class="home-profile">
    <h1 id="home-title" aria-label="I build Unreal Engine, tools, teams, games, stories and performance.">I build <span class="home-profile__carousel" data-build-words aria-hidden="true">{words.map((word, index) => <span class="home-profile__word" data-current={index === 0 ? "" : undefined}>{word}</span>)}</span></h1>
    <a href="/me" class="home-profile__name">Jabriel</a>
</div>
<script>
    let disposeCarousel: (() => void) | undefined;

    function initCarousel() {
        disposeCarousel?.();
        disposeCarousel = undefined;
        const element = document.querySelector<HTMLElement>("[data-build-words]");
        if (!element || !element.animate) return;
        const words = Array.from(element.querySelectorAll<HTMLElement>(".home-profile__word"));
        if (words.length < 2) return;
        const controller = new AbortController();
        const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
        let index = Math.max(0, words.findIndex((word) => word.hasAttribute("data-current")));
        let timer: ReturnType<typeof setTimeout> | undefined;
        let animations: Animation[] = [];
        const eligible = () => !controller.signal.aborted && !document.hidden && !motion.matches;

        function pause() {
            clearTimeout(timer);
            animations.forEach((animation) => animation.cancel());
            animations = [];
            words.forEach((word) => word.removeAttribute("data-incoming"));
        }

        function schedule() {
            if (eligible()) timer = setTimeout(exchange, 4000);
        }

        async function exchange() {
            if (!eligible()) return;
            const next = (index + 1) % words.length;
            words[next].setAttribute("data-incoming", "");
            const outgoing = words[index].animate(
                [{ transform: "translateY(0)" }, { transform: "translateY(-110%)" }],
                { duration: 240, easing: "cubic-bezier(.3, 0, .2, 1)", fill: "both" },
            );
            const incoming = words[next].animate(
                [{ transform: "translateY(110%)" }, { transform: "translateY(0)" }],
                { delay: 40, duration: 260, easing: "cubic-bezier(.22, 1, .36, 1)", fill: "both" },
            );
            animations = [outgoing, incoming];
            try {
                await Promise.all(animations.map((animation) => animation.finished));
            } catch {
                // Cancellation leaves the last settled phrase in place.
                return;
            }
            if (!eligible()) return;
            words[index].removeAttribute("data-current");
            words[next].removeAttribute("data-incoming");
            words[next].setAttribute("data-current", "");
            index = next;
            animations.forEach((animation) => animation.cancel());
            animations = [];
            schedule();
        }

        const restart = () => { pause(); schedule(); };
        document.addEventListener("visibilitychange", restart, { signal: controller.signal });
        motion.addEventListener("change", restart, { signal: controller.signal });
        disposeCarousel = () => { pause(); controller.abort(); };
        schedule();
    }
    document.addEventListener("astro:page-load", initCarousel);
    document.addEventListener("astro:before-swap", () => {
        disposeCarousel?.();
        disposeCarousel = undefined;
    });
</script>
