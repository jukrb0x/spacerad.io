---
// SearchOverlay.astro - Search modal overlay using <dialog> for proper iOS Safari viewport handling
---

<dialog
    data-pagefind-ignore
    data-search-overlay
    class="search-dialog"
    aria-label="Site Search" data-i18n-attr="aria-label" data-i18n-en="Site Search" data-i18n-zh="站内搜索"
>
    <!-- Backdrop close button -->
    <button
        type="button"
        class="search-dialog__backdrop"
        data-search-close
        aria-label="Close Search" data-i18n-attr="aria-label" data-i18n-en="Close Search" data-i18n-zh="关闭搜索"
    ></button>

    <!-- Search Container -->
    <div
        data-search-container
        class="search-dialog__container translate-y-4 transition-transform duration-200"
    >
        <!-- Search Header -->
        <div class="flex items-center gap-3 border-b border-subtle pb-3">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-5 w-5 shrink-0 text-muted"
                aria-hidden="true"
            >
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
            </svg>
            <label for="search-input" class="sr-only"><span data-i18n-en="Search the journal" data-i18n-zh="搜索博客">Search the journal</span></label>
            <input
                id="search-input"
                type="search"
                placeholder="Search the journal…" data-i18n-attr="placeholder" data-i18n-en="Search the journal…" data-i18n-zh="搜索博客…"
                class="w-full bg-transparent text-lg text-primary placeholder:text-muted focus-accent rounded"
                data-search-input
                autocomplete="off"
            />
            <kbd
                class="hidden shrink-0 rounded border border-subtle bg-page px-2 py-0.5 text-xs text-muted sm:inline-block"
                aria-hidden="true"
            >
                ESC
            </kbd>
            <button
                type="button"
                class="icon-btn icon-btn--sm icon-btn--square focus-accent sm:hidden"
                data-search-close
                aria-label="Close Search" data-i18n-attr="aria-label" data-i18n-en="Close Search" data-i18n-zh="关闭搜索"
            >
                <span aria-hidden="true" class="text-xl leading-none">&times;</span>
            </button>
        </div>

        <!-- Search Results -->
        <div
            data-search-results
            data-state="idle"
            aria-busy="false"
            data-scroll-container
            class="max-h-[60vh] overflow-y-auto py-3"
        >
            <!-- Empty state -->
            <div data-search-empty class="py-8 text-center text-muted">
                <p><span data-i18n-en="Enter keywords to search" data-i18n-zh="输入关键词开始搜索">Enter keywords to search</span></p>
                <p class="mt-2 text-sm"><span data-i18n-en="Search all posts" data-i18n-zh="搜索全部文章">Search all posts</span></p>
            </div>
            <div data-search-loading class="hidden py-8 text-center text-muted">
                <p><span data-i18n-en="Searching…" data-i18n-zh="搜索中…">Searching…</span></p>
                <p class="mt-2 text-sm"><span data-i18n-en="Looking through all posts" data-i18n-zh="正在搜索全部文章">Looking through all posts</span></p>
            </div>
            <!-- No results state (hidden by default) -->
            <div data-search-no-results class="hidden py-8 text-center text-muted">
                <p><span data-i18n-en="No results found" data-i18n-zh="没有找到结果">No results found</span></p>
                <p class="mt-2 text-sm"><span data-i18n-en="Try different keywords" data-i18n-zh="试试其他关键词">Try different keywords</span></p>
            </div>
            <div data-search-error class="hidden py-8 text-center text-muted">
                <p><span data-i18n-en="Search is unavailable" data-i18n-zh="搜索暂不可用">Search is unavailable</span></p>
                <p class="mt-2 text-sm"><span data-i18n-en="Edit your search to try again" data-i18n-zh="修改关键词后重试">Edit your search to try again</span></p>
            </div>
            <!-- Results list -->
            <ul data-search-list class="hidden space-y-2" role="listbox" aria-label="Search Results" data-i18n-attr="aria-label" data-i18n-en="Search Results" data-i18n-zh="搜索结果">
            </ul>
        </div>

        <p data-search-status class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>

        <!-- Search Footer -->
        <div class="flex items-center justify-between border-t border-subtle pt-3 text-xs text-muted">
            <span>
                <kbd class="rounded border border-subtle bg-page px-1.5 py-0.5">↵</kbd>
                <span data-i18n-en="Select" data-i18n-zh="选择">Select</span>
                <kbd class="ml-2 rounded border border-subtle bg-page px-1.5 py-0.5">↑↓</kbd>
                <span data-i18n-en="Navigate" data-i18n-zh="移动">Navigate</span>
            </span>
            <span class="flex items-center gap-1">
                <span data-i18n-en="Powered by" data-i18n-zh="搜索技术">Powered by</span>
                <a
                    href="https://pagefind.app/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-accent hover:underline focus-accent rounded"
                >
                    Pagefind
                </a>
            </span>
        </div>
    </div>
</dialog>

<script>
    import { uiLanguage } from "../i18n/client";
    import { loadSearchIndex } from "../lib/search-index";
    import { lockScrollForDialog, unlockScrollForDialog } from "../utils/scrollLock";

    let disposeSearchOverlay: (() => void) | undefined;

    function initSearchOverlay() {
        disposeSearchOverlay?.();
        const searchTrigger = document.querySelector<HTMLButtonElement>("[data-search-trigger]");
        const searchDialog = document.querySelector<HTMLDialogElement>("[data-search-overlay]");
        const searchContainer = document.querySelector<HTMLElement>("[data-search-container]");
        const searchInput = document.querySelector<HTMLInputElement>("[data-search-input]");
        const searchCloseButtons = document.querySelectorAll<HTMLButtonElement>("[data-search-close]");
        const searchEmpty = document.querySelector<HTMLElement>("[data-search-empty]");
        const searchNoResults = document.querySelector<HTMLElement>("[data-search-no-results]");
        const searchLoading = document.querySelector<HTMLElement>("[data-search-loading]");
        const searchResults = document.querySelector<HTMLElement>("[data-search-results]");
        const searchStatus = document.querySelector<HTMLElement>("[data-search-status]");
        const searchError = document.querySelector<HTMLElement>("[data-search-error]");
        const searchList = document.querySelector<HTMLElement>("[data-search-list]");

        let lastFocusedElement: Element | null = null;
        let lowerDialog: HTMLDialogElement | null = null;
        let lowerWasInert = false;
        const controller = new AbortController();
        const options = { signal: controller.signal };
        let locked = false;
        let revision = 0;
        let closeTimer: ReturnType<typeof setTimeout> | undefined;
        let debounceTimer: ReturnType<typeof setTimeout> | undefined;
        const frames = new Set<number>();
        const current = (request: number) => !controller.signal.aborted && locked && request === revision;
        const nextFrame = (callback: () => void) => {
            const id = requestAnimationFrame(() => {
                frames.delete(id);
                if (!controller.signal.aborted && locked) callback();
            });
            frames.add(id);
        };
        let selectedIndex = -1;

        function createResultItem(result: any, index: number) {
            const li = document.createElement("li");
            li.setAttribute("role", "option");
            li.setAttribute("aria-selected", "false");

            const link = document.createElement("a");
            link.href = result.url;
            link.className = "search-result-item group flex flex-col gap-1 rounded-lg p-3 transition-colors hover:bg-accent-tint-8 focus:bg-accent-tint-8 focus:outline-none";
            link.dataset.searchResultIndex = String(index);

            const title = document.createElement("span");
            title.className = "font-medium text-primary group-hover:text-accent group-focus:text-accent";
            title.textContent = result.meta?.title || result.url;

            const excerpt = document.createElement("span");
            excerpt.className = "line-clamp-2 text-sm text-secondary search-excerpt";
            if (result.excerpt) {
                excerpt.innerHTML = result.excerpt;
            }

            link.appendChild(title);
            link.appendChild(excerpt);
            li.appendChild(link);

            return li;
        }

        async function performSearch(query: string, request: number) {
            if (!current(request)) return;
            if (!query.trim()) {
                showEmpty();
                return;
            }

            try {
                const pf = await loadSearchIndex();
                if (!current(request)) return;
                if (!pf) throw new Error("Search index is unavailable");
                const search = await pf.search(query);
                if (!current(request)) return;

                if (search.results.length === 0) {
                    showNoResults();
                    return;
                }

                const results = await Promise.all(
                    search.results.slice(0, 10).map((r: any) => r.data())
                );

                if (current(request)) showResults(results);
            } catch (error) {
                if (current(request)) setSearchState("error");
                throw error;
            }
        }

        type SearchState = "idle" | "loading" | "no-results" | "error" | "results";

        // One renderer owns every query panel; async callers must pass the revision guard.
        function setSearchState(state: SearchState, count = 0) {
            const panels = { idle: searchEmpty, loading: searchLoading, "no-results": searchNoResults, error: searchError, results: searchList };
            for (const [name, panel] of Object.entries(panels)) {
                if (name === state) panel?.classList.remove("hidden");
                else panel?.classList.add("hidden");
            }
            if (searchResults) {
                searchResults.dataset.state = state;
                searchResults.setAttribute("aria-busy", String(state === "loading"));
            }
            if (state !== "results") searchList?.replaceChildren();
            if (searchStatus) {
                searchStatus.textContent = uiLanguage.get() === "zh" ? {
                    idle: "", loading: "搜索中…", "no-results": "没有找到结果", error: "搜索暂不可用，请修改关键词后重试。", results: `找到 ${count} 条结果`,
                }[state] : {
                    idle: "",
                    loading: "Searching…",
                    "no-results": "No results found",
                    error: "Search is unavailable. Edit your search to try again.",
                    results: `${count} ${count === 1 ? "result" : "results"} found`,
                }[state];
            }
            selectedIndex = -1;
        }

        function showEmpty() {
            setSearchState("idle");
        }

        function showNoResults() {
            setSearchState("no-results");
        }

        function showResults(results: any[]) {
            if (!searchList) return;
            searchList.replaceChildren();
            results.forEach((result, index) => {
                searchList.appendChild(createResultItem(result, index));
            });
            setSearchState("results", results.length);
        }

        function updateSelection(newIndex: number) {
            const items = searchList?.querySelectorAll<HTMLElement>("[data-search-result-index]");
            if (!items || items.length === 0) return;

            if (newIndex < 0) newIndex = items.length - 1;
            if (newIndex >= items.length) newIndex = 0;

            items.forEach((item, i) => {
                const li = item.closest("li");
                if (i === newIndex) {
                    li?.setAttribute("aria-selected", "true");
                    item.classList.add("bg-accent-tint-8");
                    item.focus();
                } else {
                    li?.setAttribute("aria-selected", "false");
                    item.classList.remove("bg-accent-tint-8");
                }
            });

            selectedIndex = newIndex;
        }

        function setSearchOpen(open: boolean, immediate = false, restoreFocus = true) {
            if (!searchDialog || !searchContainer || controller.signal.aborted) return;
            clearTimeout(closeTimer);
            if (open) {
                if (locked) return;
                if (!searchDialog.open) {
                    lastFocusedElement = document.activeElement;
                    lowerDialog = lastFocusedElement?.closest("dialog") ?? null;
                    searchDialog.showModal();
                    // WebKit can Tab to a lower modal's root despite native modal inertness.
                    if (lowerDialog) {
                        lowerWasInert = lowerDialog.inert;
                        lowerDialog.inert = true;
                    }
                }
                locked = true;
                lockScrollForDialog();
                nextFrame(() => {
                    searchDialog.classList.add("is-open");
                    searchInput?.focus();
                    // Do not select text entered while the opening frame was pending.
                    if (searchInput && !searchInput.value) searchInput.select();
                });
                return;
            }
            revision++;
            clearTimeout(debounceTimer);
            for (const frame of frames) cancelAnimationFrame(frame);
            frames.clear();
            searchDialog.classList.remove("is-open");
            if (locked) {
                locked = false;
                unlockScrollForDialog();
            }
            const finishClose = () => {
                if (lowerDialog) {
                    lowerDialog.inert = lowerWasInert;
                    lowerDialog = null;
                }
                searchDialog.close();
                if (restoreFocus && lastFocusedElement?.isConnected && lastFocusedElement instanceof HTMLElement) {
                    lastFocusedElement.focus({ preventScroll: true });
                }
            };
            if (immediate) finishClose();
            else closeTimer = setTimeout(() => {
                if (!locked && searchDialog.isConnected) finishClose();
            }, 200);
            if (searchInput) searchInput.value = "";
            searchList?.replaceChildren();
            showEmpty();
        }

        disposeSearchOverlay = () => {
            setSearchOpen(false, true, false);
            controller.abort();
            clearTimeout(closeTimer);
        };

        searchTrigger?.addEventListener("click", () => setSearchOpen(true), options);
        searchCloseButtons.forEach((btn) =>
            btn.addEventListener("click", () => setSearchOpen(false), options)
        );

        // Intercept browser Escape to run animated close instead
        searchDialog?.addEventListener("cancel", (e) => {
            e.preventDefault();
            setSearchOpen(false);
        }, options);

        searchList?.addEventListener("click", (event) => {
            if ((event.target as Element).closest("a")) setSearchOpen(false, true, false);
        }, options);
        searchDialog?.addEventListener("close", () => {
            if (!searchDialog.open && (locked || lowerDialog)) setSearchOpen(false, true);
        }, options);

        document.addEventListener("keydown", (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key === "k") {
                e.preventDefault();
                setSearchOpen(true);
            }
        }, options);

        searchDialog?.addEventListener("keydown", (e) => {
            if (!searchDialog?.open) return;

            // Search inputs can consume Escape before the native dialog cancel event.
            if (e.key === "Escape") {
                e.preventDefault();
                setSearchOpen(false);
                return;
            }

            if (e.key === "ArrowDown") {
                e.preventDefault();
                updateSelection(selectedIndex + 1);
            } else if (e.key === "ArrowUp") {
                e.preventDefault();
                updateSelection(selectedIndex - 1);
            } else if (e.key === "Enter" && selectedIndex >= 0) {
                const items = searchList?.querySelectorAll<HTMLElement>("[data-search-result-index]");
                const selected = items?.[selectedIndex];
                if (selected) {
                    e.preventDefault();
                    selected.click();
                }
            }
        }, options);
        searchInput?.addEventListener("input", (e) => {
            const query = (e.target as HTMLInputElement).value;
            const request = ++revision;
            clearTimeout(debounceTimer);
            // Update before debounce and index loading, including cancellation by empty input.
            setSearchState(query.trim() ? "loading" : "idle");
            if (!query.trim()) return;
            debounceTimer = setTimeout(() => {
                void performSearch(query, request).catch((error) => {
                    if (current(request)) console.error("Search failed:", error);
                });
            }, 200);
        }, options);
    }

    document.addEventListener("astro:page-load", initSearchOverlay);
    document.addEventListener("astro:before-swap", () => {
        disposeSearchOverlay?.();
        disposeSearchOverlay = undefined;
    });
</script>

<style>
    /* Pagefind highlight styles */
    .search-excerpt :global(mark) {
        background-color: var(--color-channel);
        color: var(--color-on-channel);
        border-radius: 2px;
        padding: 0 2px;
    }
</style>
