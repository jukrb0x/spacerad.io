---
import { getPublishedPosts, groupPostsByYear } from "../utils/posts";
import PostItem from "./PostItem.astro";

const posts = await getPublishedPosts();
const groupedPosts = groupPostsByYear(posts);
---

<section class="section-stack">
	<div class="flex items-center justify-end mb-4">
		<div class="lang-switcher inline-flex select-none items-center gap-1 text-sm text-muted" role="group" aria-label="Posts language">
			<button
				id="lang-all"
				type="button"
				class="lang-btn px-2 py-0.5 rounded transition-colors"
				data-lang="all"
			>All</button>
			<button
				id="lang-en"
				type="button"
				class="lang-btn px-2 py-0.5 rounded transition-colors"
				data-lang="en"
			>English</button>
			<button
				id="lang-zh"
				type="button"
				class="lang-btn px-2 py-0.5 rounded transition-colors"
				data-lang="zh"
			>中文</button>
		</div>
	</div>
    {groupedPosts.map(([year, yearPosts]) => (
        <section class="archive-year" data-year-group aria-labelledby={`archive-year-${year}`}>
            <h2 class="archive-year__heading" id={`archive-year-${year}`}>
                <span class="archive-year__label">{year}</span>
                <span class="archive-year__number" aria-hidden="true">{year}</span>
            </h2>
            <ul class="archive-list">{yearPosts.map(post => <PostItem post={post} posts={posts} />)}</ul>
        </section>
    ))}
</section>



<script is:inline data-astro-rerun>
	(function() {
		const yearGroups = document.querySelectorAll('[data-year-group]');
		const langButtons = document.querySelectorAll('.lang-btn');

		if (!langButtons.length) return;

		const LANG_KEY = 'posts-lang-filter';
		let currentLang = 'all';
		try { currentLang = window.localStorage.getItem(LANG_KEY) || 'all'; } catch {}
		if (!['all', 'en', 'zh'].includes(currentLang)) currentLang = 'all';

		const setActiveButton = (lang) => {
			langButtons.forEach((btn) => {
				btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
				btn.setAttribute('aria-pressed', String(btn.getAttribute('data-lang') === lang));
			});
		};

		const applyFilter = (lang) => {
			currentLang = lang;
			try { window.localStorage.setItem(LANG_KEY, lang); } catch {}
			setActiveButton(lang);

			yearGroups.forEach((group) => {
				let visibleCount = 0;
				group.querySelectorAll('li[data-lang]').forEach((item) => {
					const itemLang = item.getAttribute('data-lang');
					const shouldShow = lang === 'all' || itemLang === lang;
					item.style.display = shouldShow ? '' : 'none';
					if (shouldShow) visibleCount += 1;
				});

				group.hidden = visibleCount === 0;
			});
		};

		langButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				applyFilter(btn.getAttribute('data-lang'));
			});
		});

		applyFilter(currentLang);
	})();
</script>
