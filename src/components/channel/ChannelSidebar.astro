---
import { CHANNEL_DESCRIPTION_MODE } from "../../consts";
import { type ChannelDescriptionMode, formatChannelDescription } from "../../utils/channelDescription";

interface Props {
    title: string;
    description: string;
    descriptionMode?: ChannelDescriptionMode;
    avatar: string;
    username: string;
}

const { title, description, descriptionMode = CHANNEL_DESCRIPTION_MODE, avatar, username } = Astro.props;
const visibleDescription = formatChannelDescription(description, descriptionMode);
---

<aside class="channel-sidebar" aria-labelledby="channel-title">
    <div class="channel-sidebar__card" data-description-layout={descriptionMode}>
        <p class="channel-sidebar__identity">Channel</p>
        <img src={avatar} alt={title} width="88" height="88" class="channel-sidebar__avatar" />
        <h1 id="channel-title" class="channel-sidebar__title">{title}</h1>
        {visibleDescription && (
            <div class="channel-sidebar__description" data-description-mode={descriptionMode}>{visibleDescription}</div>
        )}
    </div>
    <nav class="channel-sidebar__actions" aria-label="Follow the channel">
        <a href={`https://t.me/${username}`}
           target="_blank"
           rel="noopener noreferrer"
           class="channel-sidebar__btn channel-sidebar__btn--primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Open in Telegram
        </a>
        <a href="/channel-rss.xml"
           class="channel-sidebar__btn channel-sidebar__btn--ghost">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="5" cy="19" r="1" fill="currentColor"/>
            </svg>
            RSS Feed
        </a>
    </nav>
</aside>

<style>
.channel-sidebar {
    display: flow-root;
    position: sticky;
    top: calc(var(--header-offset, 0px) + 28px);
    transition: top 0.3s ease;
    width: 100%;
    max-width: 280px;
    margin-inline: auto;
    container-type: inline-size;
}

.channel-sidebar__card {
    box-sizing: border-box;
    aspect-ratio: 1;
    height: 100cqi;
    margin-top: -8%;
    padding: 28px 16px 40px;
    border-radius: 50%;
    clip-path: inset(8% 0 0);
    background: var(--color-channel);
    color: var(--color-on-channel);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.channel-sidebar__identity {
    margin: 0 0 14px;
    color: inherit;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
}

.channel-sidebar__avatar {
    flex-shrink: 0;
    box-sizing: border-box;
    width: 88px;
    height: 88px;
    border: 3px solid var(--color-on-structure);
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 12px;
}

.channel-sidebar__title {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: inherit;
    margin: 0 0 8px;
    line-height: 1.2;
}

.channel-sidebar__description {
    font-size: var(--font-size-xs);
    color: inherit;
    line-height: 1.5;
    width: 100%;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
    flex-shrink: 0;
}

/* Fit the original three-line bio without resizing its text, avatar or circle. */
.channel-sidebar__card[data-description-layout="full"] { padding-bottom: 32px; }
.channel-sidebar__card[data-description-layout="full"] .channel-sidebar__identity { margin-bottom: 8px; }
.channel-sidebar__card[data-description-layout="full"] .channel-sidebar__avatar { margin-bottom: 8px; }
.channel-sidebar__card[data-description-layout="full"] .channel-sidebar__title { margin-bottom: 6px; }

.channel-sidebar__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: calc(100% - 32px);
    margin: var(--space-3) auto 0;
}

.channel-sidebar__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: 999px;
    min-height: 44px;
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-decoration: none;
    transition: background var(--transition-base), color var(--transition-base);
}

.channel-sidebar__btn--primary {
    background: var(--color-structure);
    color: var(--color-on-structure);
    border: 1px solid var(--color-structure);
}

.channel-sidebar__btn--ghost {
    background: transparent;
    color: var(--color-text-primary);
    border: 1px solid currentColor;
}

.channel-sidebar__btn:hover { text-decoration: underline; }
.channel-sidebar__btn:focus-visible { outline: 3px solid var(--color-language); outline-offset: 3px; }

@media (max-width: 960px) {
    .channel-sidebar { position: static; }
}
</style>
