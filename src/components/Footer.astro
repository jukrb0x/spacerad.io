---
import { SOCIAL_LINKS } from "../consts";
import PostPreviewCard from "./PostPreviewCard.astro";

const today = new Date();
---
<footer class="site-footer" data-pagefind-ignore>
    <div class="site-footer__inner">
        <span>2017–{today.getFullYear()} © Jabriel</span>
        <nav aria-label="Subscriptions and social links"><a href={SOCIAL_LINKS.github} target="_blank" rel="noreferrer">GitHub</a><a href={SOCIAL_LINKS.telegram} target="_blank" rel="noreferrer">Telegram</a><a href={SOCIAL_LINKS.rss}>RSS</a><a href="/tags">Tags</a><a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noreferrer" aria-label="Creative Commons BY-NC-SA 4.0 license">CC BY-NC-SA</a></nav>
        <a href={SOCIAL_LINKS.email}>fm@spacerad.io</a>
    </div>
</footer>
<PostPreviewCard />
