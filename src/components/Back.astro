---
interface Props {
    href?: string;
    label?: string;
}

const { href, label } = Astro.props;

// Calculate parent path from current URL if href not provided
const getParentPath = () => {
    const path = Astro.url.pathname.replace(/\/$/, ""); // Remove trailing slash
    const segments = path.split("/").filter(Boolean);
    if (segments.length <= 1) return "/";
    return "/" + segments.slice(0, -1).join("/");
};

const backHref = href ?? getParentPath();
const backLabel = label ?? ({ "/": "Home", "/posts": "All writing", "/tags": "All topics", "/channel": "All notes" }[backHref] || "Back");
---

<div class="editorial-back">
    <a href={backHref}>
        <span aria-hidden="true">←</span> <span data-i18n-en={backLabel} data-i18n-zh={label ?? ({ "/": "首页", "/posts": "全部文章", "/tags": "全部话题", "/channel": "全部动态" }[backHref] || "返回")}>{backLabel}</span>
    </a>
</div>
