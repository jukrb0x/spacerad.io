---
// Import the global styles here so that they are included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.scss";
import "../styles/editorial.css";
import "../styles/code-blocks.css";
import "../styles/i18n.css";
import { ClientRouter } from "astro:transitions";
import { SITE_SOCIAL_IMAGE, SITE_TITLE, SITE_TITLE_OG } from "../consts";

interface Props {
    title: string;
    description: string;
    image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = SITE_SOCIAL_IMAGE } = Astro.props;
const socialImageURL = new URL(image, canonicalURL);
const isDefaultSocialImage = image === SITE_SOCIAL_IMAGE;
---

<!-- Read preference before paint; the module owns updates after navigation. -->
<script is:inline>
    (() => {
        let stored;
        try { stored = localStorage.getItem("ui-language"); } catch {}
        const languages = navigator.languages || [navigator.language];
        const detected = languages.map(value => value.toLowerCase().split("-")[0]).find(value => value === "en" || value === "zh");
        document.documentElement.dataset.uiLanguage = stored === "en" || stored === "zh" ? stored : detected || "en";
    })();
</script>
<script>import "../i18n/client";</script>
<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<ClientRouter />

<!-- Theme initialization script (prevents FOUC) - only runs on initial load -->
<script is:inline>
    (() => {
        const storageKey = "theme-preference";
        const root = document.documentElement;
        const isPreference = (value) =>
            value === "light" || value === "dark" || value === "system";

        let preference = "system";

        try {
            const stored = window.localStorage.getItem(storageKey);
            if (isPreference(stored)) {
                preference = stored;
            }
        } catch {
            /* noop */
        }

        const getSystemTheme = () => {
            if (!window.matchMedia) return "light";
            return window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
        };

        const theme = preference === "system" ? getSystemTheme() : preference;
        root.dataset.themeMode = preference;
        root.dataset.theme = theme;
    })();
</script>

<!-- Viewport height initialization (prevents FOUC on iOS Safari) -->
<script is:inline>
    (function(){
        var vh = (window.visualViewport?.height ?? window.innerHeight) * 0.01;
        document.documentElement.style.setProperty('--vh', vh + 'px');
    })();
</script>
<script>
    import { initViewportHeight } from "../utils/viewportHeight";
    import { initTheme } from "../lib/theme-effects";

    initViewportHeight();
    initTheme();
</script>
<link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" href="/favicon.ico?v=v8-02" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=v8-02" />
<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=v8-02" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=v8-02" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />


<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- License -->
<link rel="license" href="https://creativecommons.org/licenses/by-nc-sa/4.0/" />
<meta name="license" content="CC BY-NC-SA 4.0" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
{isDefaultSocialImage && (
    <>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={SITE_TITLE_OG} />
    </>
)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageURL} />
{isDefaultSocialImage && <meta property="twitter:image:alt" content={SITE_TITLE_OG} />}
