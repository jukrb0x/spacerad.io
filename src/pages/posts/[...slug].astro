---
import { type CollectionEntry, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { getAllRenderablePosts } from "../../utils/posts";
import { getPostTranslation } from "../../utils/postTranslations";

export const prerender = true;

export async function getStaticPaths() {
    const posts = await getAllRenderablePosts();
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { ...post, translation: getPostTranslation(post.id, posts) },
    }));
}
type Props = CollectionEntry<"blog"> & { translation?: CollectionEntry<"blog"> };

const post = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
---

<BlogPost
    {...post.data}
    translation={post.translation}
    body={post.body}
    headings={headings}
    lastModified={remarkPluginFrontmatter?.lastModified}
    lastModifiedCommitUrl={remarkPluginFrontmatter?.lastModifiedCommitUrl}
>
    <Content />
</BlogPost>
