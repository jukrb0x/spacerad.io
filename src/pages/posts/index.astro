---
import BaseHead from "@components/BaseHead.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import PostList from "@components/PostList.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
---
<!doctype html>
<html lang="en">
    <head><BaseHead title={`Posts | ${SITE_TITLE}`} description={SITE_DESCRIPTION} /></head>
    <body class="archive-page">
        <Header />
        <main id="main-content" tabindex="-1" class="page-shell" transition:animate="fade">
            <div data-pagefind-body data-pagefind-weight="0.1" class="archive-heading"><h1>Posts</h1><p>Essays and explorations, in English and Chinese.</p></div>
            <PostList />
        </main>
        <Footer />
    </body>
</html>
