---
import BaseHead from "@components/BaseHead.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import LatestChannelSlot from "@components/home/LatestChannelSlot.astro";
import LatestPosts from "@components/home/LatestPosts.astro";
import { SITE_DESCRIPTION, SITE_TITLE_OG } from "../consts";
export const prerender = true;
---
<!doctype html>
<html lang="en">
    <head><BaseHead title={SITE_TITLE_OG} description={SITE_DESCRIPTION} /><meta data-pagefind-meta="title[content]" content="Space Radio" /></head>
    <body class="home-page">
        <Header />
        <main id="main-content" tabindex="-1" class="editorial-shell" transition:animate="fade">
            <LatestPosts />
            <section class="home-channel" aria-labelledby="channel-title">
                <div class="home-channel__identity"><h2 id="channel-title"><a class="section-heading-link" href="/channel">Channel<span class="section-heading-link__wipe" aria-hidden="true">Channel</span></a></h2><a class="home-channel__more" href="/channel">进入电台 <span aria-hidden="true">→</span></a></div>
                <LatestChannelSlot />
            </section>
        </main>
        <Footer />
    </body>
</html>
