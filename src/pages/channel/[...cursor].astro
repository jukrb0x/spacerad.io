---
/**
 * Telegram Channel
 */

import BaseHead from "@components/BaseHead.astro";
import ChannelSidebar from "@components/channel/ChannelSidebar.astro";
import PostCard from "@components/channel/PostCard.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Lightbox from "@components/Lightbox.astro";
import type { TelegramChannel } from "../../utils/telegram";
import { getCachedTelegramChannel } from "../../utils/telegram-cache";

// Enable server-side rendering for this dynamic route
export const prerender = false;

const { cursor } = Astro.params;
const CHANNEL_USERNAME = "SpaceRad_io";

// Parse cursor parameter
const cursorType = cursor?.startsWith("before-") ? "before" : cursor?.startsWith("after-") ? "after" : null;
const cursorValue = cursor ? cursor.replace(/^(before-|after-)/, "") : undefined;

let channelData: TelegramChannel | undefined;
let error: string | null = null;

try {
    const options: { before?: string; after?: string } = {};
    if (cursorType === "before" && cursorValue) {
        options.before = cursorValue;
    } else if (cursorType === "after" && cursorValue) {
        options.after = cursorValue;
    }

    channelData = await getCachedTelegramChannel(CHANNEL_USERNAME, options, cursorType === "before" ? 300 : 60);
} catch (e) {
    error = e instanceof Error ? e.message : "Failed to load channel";
    console.error("Error loading Telegram channel:", e);
}

// Get first and last post IDs for pagination
const firstPostId = channelData?.posts?.[0]?.id;
const lastPostId = channelData?.posts?.[channelData.posts.length - 1]?.id;

// Determine if there are more posts
const hasNewerPosts = cursorType === "before" || cursorType === "after";
const hasOlderPosts = !cursorType || (channelData?.posts && channelData.posts.length > 0);

// Freshness is owned by the shared data cache, not an additional HTML cache.
Astro.response.headers.set("Cache-Control", error ? "no-store" : "no-cache");
if (error) Astro.response.status = 503;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={channelData?.title ? `${channelData.title} - Updates` : 'Updates'}
      description={channelData?.description || 'My latest updates and shares'}
      image={channelData?.avatar}
    />
  </head>
  <body class="notes-page">
    <Header />
    <main id="main-content" tabindex="-1" class="page-shell" transition:animate="fade">
      {error ? (
        <div class="error-message surface-card">
          <h1><span data-i18n-en="Channel is temporarily unavailable" data-i18n-zh="电台暂时无法访问">Channel is temporarily unavailable</span></h1>
          <p><span data-i18n-en="The channel couldn’t be reached. You can read the same notes on Telegram." data-i18n-zh="暂时无法连接电台，你可以在 Telegram 阅读这些动态。">The channel couldn’t be reached. You can read the same notes on Telegram.</span></p>
          <p>
            Please visit <a href={`https://t.me/${CHANNEL_USERNAME}`} target="_blank" rel="noopener noreferrer">
              Telegram channel
            </a>
          </p>
        </div>
      ) : channelData ? (
        <div class="channel-layout">
          <ChannelSidebar
            title={channelData.title}
            description={channelData.descriptionText}
            avatar={channelData.avatar}
            username={CHANNEL_USERNAME}
          />
          {/* Main content: posts + pagination */}
          <div class="channel-main section-stack">
            {/* Posts list */}
            <div class="posts-container">
              {channelData.posts.map((post) => (
                <PostCard post={post} channelUsername={CHANNEL_USERNAME} />
              ))}
            </div>

            {/* Pagination */}
            <nav class="pagination">
              {hasNewerPosts && firstPostId && (
                <a href={`/channel/after-${firstPostId}`} class="pagination__link pagination__link--prev">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span data-i18n-en="Newer posts" data-i18n-zh="较新动态">Newer posts</span>
                </a>
              )}
              <a href="/channel"
                 class:list={["pagination__link", "pagination__link--home", { "pagination__link--active": !cursor }]}>
                <span data-i18n-en="Latest" data-i18n-zh="最新动态">Latest</span>
              </a>
              {hasOlderPosts && lastPostId && (
                <a href={`/channel/before-${lastPostId}`} class="pagination__link pagination__link--next">
                  <span data-i18n-en="Older posts" data-i18n-zh="较早动态">Older posts</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              )}
            </nav>
          </div>
        </div>
      ) : null}
    </main>
    <Footer />
    <Lightbox id="channel-lightbox" selector=".post-card__content img:not([data-lightbox-skip]), .telegram-post-image" />
  </body>
</html>

<script>
  // Mark channel images for lightbox and lazy load
  function initChannelImages() {
    document.querySelectorAll('.post-card__content img').forEach((element) => {
      const img = element as HTMLImageElement;
      img.classList.add('telegram-post-image');
      img.loading = img.loading || 'lazy';
    });
  }

  initChannelImages();
  document.addEventListener('astro:page-load', initChannelImages);
</script>

<style>
  .page-shell {
    padding-top: 28px;
  }

  .channel-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    grid-template-areas: "posts channel";
    gap: var(--space-8);
    max-width: 64rem;
    margin: 0 auto;
  }

  .channel-main {
    grid-area: posts;
    min-width: 0;
  }

  /* Sidebar sticky positioning - align-self: start prevents grid stretching */
  .channel-layout > :global(.channel-sidebar) {
    grid-area: channel;
    align-self: start;
  }

  .posts-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .posts-container > :global(.post-card:first-child .post-card__content > :first-child) {
    margin-top: 0;
  }

  @media (min-width: 961px) {
    .posts-container > :global(.post-card:first-child) {
      padding-top: 0;
    }
  }

  .error-message {
    text-align: center;
    padding: var(--space-8) var(--space-4);
    color: var(--color-text-secondary);
  }

  .error-message h1 {
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .error-message a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* Pagination */
  .pagination {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    align-items: center;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-soft);
  }

  .pagination__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    text-decoration: none;
    font-size: var(--font-size-sm);
    font-weight: 500;
    transition: all var(--transition-base);
  }

  .pagination__link:hover {
    background: var(--color-bg-muted);
    border-color: var(--color-border);
  }

  .pagination__link--home {
    background: var(--color-bg-muted);
  }

  .pagination__link--active {
    background: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
  }

  .pagination__link--active:hover {
    background: var(--color-accent-dark);
    border-color: var(--color-accent-dark);
  }

  @media (max-width: 960px) {
    .channel-layout {
      grid-template-columns: 1fr;
      grid-template-areas: "channel" "posts";
      row-gap: 20px;
      max-width: 42rem;
    }

    .posts-container > :global(.post-card:first-child) {
      padding-top: var(--space-4);
    }
  }

  @media (max-width: 640px) {
    .pagination {
      flex-direction: column;
      gap: var(--space-2);
    }

    .pagination__link {
      width: 100%;
      justify-content: center;
    }
  }
</style>
