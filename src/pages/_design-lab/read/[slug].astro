---
import { type CollectionEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseHead from "../../../components/BaseHead.astro";
import LabHeader from "../../../components/design-lab/LabHeader.astro";
import FormattedDate from "../../../components/FormattedDate.astro";
import Lightbox from "../../../components/Lightbox.astro";
import Prose from "../../../components/Prose.astro";
import { getPublishedPosts } from "../../../utils/posts";
import { calculateReadingTime } from "../../../utils/readingTime";
import "../../../styles/design-lab/prototype.css";
import "katex/dist/katex.min.css";
export const prerender = true;
export async function getStaticPaths() {
    const posts = await getPublishedPosts();
    const ids = ["introducing-space-radio", "ue5-landscape-grass-en"];
    return posts.filter((post) => ids.includes(post.id)).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
interface Props {
    post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const contents = headings.filter((heading) => heading.depth === 2);
---
<!doctype html>
<html lang={post.data.lang === "zh" ? "zh-CN" : "en"}><head><BaseHead title={`${post.data.title} · Art study`} description={post.data.description || "Writing by Jabriel"} /><meta name="robots" content="noindex,nofollow" /></head>
<body class="lab-page" data-pagefind-ignore="all">
<LabHeader />
<main id="lab-main" class="lab-main" tabindex="-1">
    <article class="lab-reading">
        <a class="lab-reading__back" href="/design-lab">← Space Radio</a>
        <header class="lab-reading__header"><h1>{post.data.title}</h1><div class="lab-meta"><span>Jabriel</span><time datetime={post.data.published.toISOString()}><FormattedDate date={post.data.published} /></time><span>{calculateReadingTime(post.body || "")}</span></div><p class="lab-reading__original"><a href={`/posts/${post.id}`}>Open original article with comments & sharing <Icon name="ri:arrow-right-up-line" class="link-arrow" aria-hidden="true" focusable="false" is:inline /></a></p></header>
        {contents.length > 0 && <details class="lab-contents"><summary>Contents</summary><ol>{contents.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></details>}
        <div class="lab-reading__body"><Prose><Content /></Prose></div>
        <Lightbox id="lab-lightbox" selector=".lab-reading .prose img:not([data-lightbox-skip])" />
    </article>
    <footer class="lab-foot"><a href="/design-lab">← Back to Space Radio</a><a href="/posts">All writing <Icon name="ri:arrow-right-up-line" class="link-arrow" aria-hidden="true" focusable="false" is:inline /></a></footer>
</main>
<script>import "../../../scripts/code-blocks";</script>
</body></html>
