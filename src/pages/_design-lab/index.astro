---
import { Image } from "astro:assets";
import avatar from "../../assets/design-lab/jabriel-avatar.png";
import radioPreview from "../../assets/design-lab/radio-preview.json";
import BaseHead from "../../components/BaseHead.astro";
import LabHeader from "../../components/design-lab/LabHeader.astro";
import LabRadio from "../../components/design-lab/LabRadio.astro";
import Outlook from "../../components/design-lab/Outlook.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { getPublishedPosts } from "../../utils/posts";
import "../../styles/design-lab/prototype.css";
export const prerender = true;
const posts = (await getPublishedPosts()).filter((post) => !post.data.draft);
const selected = posts.find((post) => post.id === "introducing-space-radio");
const landscape = posts.find((post) => post.id === "ue5-landscape-grass-en");
const xcode = posts.find((post) => post.id === "just-bought-a-new-domain-name-xcode-zip");
if (!selected || !landscape || !xcode) throw new Error("A curated art-study post is missing from the content collection.");
const image = landscape.data.socialImage;
---
<!doctype html>
<html lang="en"><head><BaseHead title="Space Radio · Architectural art study" description="A local art-direction study for Jabriel’s personal Space Radio." /><meta name="robots" content="noindex,nofollow" /></head>
<body class="lab-page" data-pagefind-ignore="all">
<LabHeader />
<main id="lab-main" class="lab-main" tabindex="-1">
    <section class="lab-stage" aria-labelledby="lab-title">
        <div class="lab-intro">
            <div class="lab-person"><Image src={avatar} alt="" width={48} height={48} loading="eager" /><p>My friends call me Jabriel (JB).<span>Game engine programmer</span></p></div>
            <h1 id="lab-title">Space Radio</h1>
            <p class="lab-bio">I work on game engines, and love stories, climbing and theoretical physics. <a href="/me">A little about me ↗</a></p>
            <article class="lab-chosen" lang="zh-CN">
                <div class="lab-meta"><span>Selected writing</span><time datetime={selected.data.published.toISOString()}><FormattedDate date={selected.data.published} /></time></div>
                <h2><a href="/design-lab/read/introducing-space-radio">{selected.data.title}</a></h2>
                <p>“这不是一个技术型博客，而是对这个世界有不同视角的观察的一个记录。”</p>
                <a class="lab-read" href="/design-lab/read/introducing-space-radio">Read the essay <span aria-hidden="true">↗</span></a>
            </article>
        </div>
        <Outlook />
    </section>
    <div class="lab-below">
        <section id="writing" aria-labelledby="lab-writing-title">
            <div class="lab-section-heading"><h2 id="lab-writing-title">More writing</h2><a href="/posts">The archive ↗</a></div>
            <article class="lab-feature">
                {image && typeof image !== "string" && <a class="lab-feature__image" href="/design-lab/read/ue5-landscape-grass-en" tabindex="-1" aria-hidden="true"><Image src={image} alt="" width={760} loading="lazy" /></a>}
                <div class="lab-meta"><span>Game engines</span><time datetime={landscape.data.published.toISOString()}><FormattedDate date={landscape.data.published} /></time></div>
                <h3><a href="/design-lab/read/ue5-landscape-grass-en">{landscape.data.title}</a></h3>
                <p>{landscape.data.description}</p>
            </article>
            <article class="lab-small-writing"><h3><a href={`/posts/${xcode.id}`}>{xcode.data.title}</a></h3><time datetime={xcode.data.published.toISOString()}><FormattedDate date={xcode.data.published} /></time><p>“It has nothing related to Apple.” 😆</p></article>
        </section>
        <section class="lab-radio" id="radio" aria-labelledby="lab-radio-title">
            <div class="lab-section-heading"><h2 id="lab-radio-title">On the radio</h2><a href="/channel">All notes ↗</a></div>
            <p>Passing thoughts, music, discoveries.<br />From my public Telegram channel.</p>
            <LabRadio server:defer><Fragment slot="fallback" set:html={radioPreview.html} /></LabRadio>
        </section>
    </div>
    <footer class="lab-foot"><span>Jabriel · Space Radio · Since 2017</span><nav aria-label="More from the journal"><a href="/me">About</a><a href="/tags">Topics</a><a href="/friends">Friends</a><a href="/rss.xml">RSS</a><a href="https://github.com/jukrb0x">GitHub ↗</a></nav></footer>
</main>
</body></html>
